Package: clr
Type: Package
Title: Curve Linear Regression via Dimension Reduction
Version: 0.1.3
Authors@R: c(
    person("Amandine", "Pierrot", email = "amandine.m.pierrot@gmail.com", 
    role = c("cre", "aut")),
